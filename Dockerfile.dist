# Lean image build for CI: copies binaries built bare on the runner (host sccache)
# into distroless. No in-container compilation -> fast, low-memory, no build secrets.
# The binaries must be staged in ./dist (see the build-binaries composite action).
# Local development still uses the source-building `Dockerfile` via compose.

FROM gcr.io/distroless/base-debian12:nonroot AS runtime

LABEL maintainer="stephane-segning <selastlambou@gmail.com>"
LABEL org.opencontainers.image.description="Backend for LightBridge Authz"

# Build stamp (#573), promoted from ARG to ENV so the running process can read the identity of the
# IMAGE it is inside. The binary already carries its own git SHA, commit date and rustc version,
# compiled in by `crates/lightbridge-authz-core/build.rs` — but the image does not exist yet at
# compile time (CI builds binaries in one job and the image in a later one), so these three arrive
# here instead and are read at runtime by `lightbridge_authz_core::build_info`.
#
# Empty defaults are load-bearing: an image built without them reports `null` for these fields
# rather than a fabricated value, and `/version` says so plainly.
#
# Not the image DIGEST, deliberately — a digest cannot be baked into the artifact it identifies.
# `IMAGE_TAG` carries the immutable `:<commit-sha>` tag, which resolves to exactly one digest.
ARG IMAGE_BUILD_SHA=""
ARG IMAGE_TAG=""
ARG IMAGE_BUILD_TIME=""
ENV IMAGE_BUILD_SHA=${IMAGE_BUILD_SHA} \
    IMAGE_TAG=${IMAGE_TAG} \
    IMAGE_BUILD_TIME=${IMAGE_BUILD_TIME}

WORKDIR /app

COPY dist/lightbridge-authz /usr/local/bin/lightbridge-authz
COPY dist/lightbridge-authz-healthcheck /usr/local/bin/lightbridge-authz-healthcheck

# Hosted login page static build (ADR-0021 Decisions 1 + 10, amended by ADR-0029) -- staged into
# dist/static by the `stage-authz-ui` composite action, which pulls it out of the digest-pinned
# assets-only image named by ./Dockerfile's `ARG AUTHZ_UI_REF=` (the one pin location) and rides
# the same dist-binaries.tar.gz as the prebuilt binaries above. This file needs no pin of its own,
# deliberately: two pins would drift, and a Dockerfile.dist image serving a different UI than a
# compose-built Dockerfile image is exactly the kind of divergence nobody notices until they diff
# two running containers. authz-idp serves this from `server.idp.static_dir`, which
# .docker/authz/container.yaml points at this exact path. Harmless on the other runtime stages
# below, which never mount the static fallback.
COPY dist/static /app/static

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=1s --retries=3 \
    CMD ["/usr/local/bin/lightbridge-authz-healthcheck", "-r", "3000"]

ENV RUST_LOG=info

USER 65532:65532

ENTRYPOINT ["lightbridge-authz"]

FROM gcr.io/distroless/base-debian12:nonroot AS usage-runtime

LABEL maintainer="stephane-segning <selastlambou@gmail.com>"
LABEL org.opencontainers.image.description="Backend for LightBridge Authz Usage"

# Build stamp (#573) — see the `runtime` stage above for why these are ARG -> ENV and not a digest.
ARG IMAGE_BUILD_SHA=""
ARG IMAGE_TAG=""
ARG IMAGE_BUILD_TIME=""
ENV IMAGE_BUILD_SHA=${IMAGE_BUILD_SHA} \
    IMAGE_TAG=${IMAGE_TAG} \
    IMAGE_BUILD_TIME=${IMAGE_BUILD_TIME}

WORKDIR /app

COPY dist/lightbridge-authz-usage /usr/local/bin/lightbridge-authz-usage
COPY dist/lightbridge-authz-healthcheck /usr/local/bin/lightbridge-authz-healthcheck

EXPOSE 3002

ENV RUST_LOG=info

USER 65532:65532

ENTRYPOINT ["lightbridge-authz-usage"]
CMD ["serve"]

FROM gcr.io/distroless/base-debian12:nonroot AS mcp-runtime

LABEL maintainer="stephane-segning <selastlambou@gmail.com>"
LABEL org.opencontainers.image.description="Backend for LightBridge Authz MCP"

# Build stamp (#573) — see the `runtime` stage above for why these are ARG -> ENV and not a digest.
ARG IMAGE_BUILD_SHA=""
ARG IMAGE_TAG=""
ARG IMAGE_BUILD_TIME=""
ENV IMAGE_BUILD_SHA=${IMAGE_BUILD_SHA} \
    IMAGE_TAG=${IMAGE_TAG} \
    IMAGE_BUILD_TIME=${IMAGE_BUILD_TIME}

WORKDIR /app

COPY dist/lightbridge-mcp /usr/local/bin/lightbridge-mcp
COPY dist/lightbridge-authz-healthcheck /usr/local/bin/lightbridge-authz-healthcheck

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=1s --retries=3 \
    CMD ["/usr/local/bin/lightbridge-authz-healthcheck", "-r", "3000"]

ENV RUST_LOG=info

USER 65532:65532

ENTRYPOINT ["lightbridge-mcp"]
CMD ["serve"]
