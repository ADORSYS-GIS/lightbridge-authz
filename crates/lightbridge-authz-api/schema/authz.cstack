// authz-api CRUD schema (ADR-0003: cratestack-pg migration; ADR-0006: project
// membership supersedes account roles).
//
// Owns: accounts, projects, api_keys, project_members (cratestack-generated
// CRUD + migrations going forward). project_members is modeled here too, but
// ONLY as a relation target for @@allow/@@deny policy traversal -- its real
// schema evolution stays owned by the hand-written SQLx migrations under
// migrations/, per the ADR's scope boundary. See the `ProjectMember` model
// below for the specific caveat this creates.
//
// Per ADR-0006: a person's defining identity is their `accountId` -- there is
// no account-level membership of any kind. Every account has a default,
// roster-less project ("you, working alone"); real projects have a roster
// (`ProjectMember`, role: lead|member). `billingIdentity` lives on `Project`,
// not `Account`. `account_memberships` (ADR-0002/0005) is removed entirely.

transport rpc

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

// `rpcScope` + the 31 `perm*` booleans below are issue #383's fix, not part of the original
// ADR-0003 migration. Background: cratestack 0.8.4 rewrote `POST /rpc/batch` to authenticate the
// envelope exactly once (`CachedAuthProvider`), so `CratestackAuthProvider::authenticate` --
// previously the sole per-frame RBAC enforcement point -- can no longer see an individual batch
// frame's op-id at all. What cratestack's OWN per-frame policy evaluation (`authorize_procedure`
// for procedures, the model read-policy equivalent for `model.*` verbs -- both invoked from inside
// `#dispatch_ident`, re-entered once per batch frame exactly like a unary call, completely
// unaffected by the auth-caching change; see `crates/cratestack-macros/src/procedure/instrument.rs`)
// CAN still see is which permission a given op-id requires, because that's a schema-compile-time
// constant, not something read off the per-request path. So the coarse RBAC gate moves here:
// `CratestackAuthProvider` bakes the caller's REAL, already-computed `TokenInfo::has_permission`
// verdict for every permission (plus which server -- authz-api vs authz-budget -- is asking, via
// `rpcScope`) into one auth context, once, at authenticate() time (envelope-once for batch, same as
// ever for unary), and every mapped op-id's `@allow`/`@@allow` clause below reads the ONE boolean
// it needs back out, per frame. See `crates/lightbridge-authz-rest/src/auth_provider.rs` (where
// these fields are populated) and `crates/lightbridge-authz-rest/tests/schema_policy_sync_tests.rs`
// (the generator/drift-check this block and every amended clause below were produced by, driven
// from `rpc_authorize::MAPPED_OP_ID_PERMISSIONS` -- NOT hand-transcribed, to keep 43 op-ids' worth
// of clauses from silently drifting out of sync with the Rust-side permission map). Every original
// expression is parenthesized before the appended `&& auth().rpcScope == ... && auth().perm... ==
// true` clause -- without the parens, `a || b && c` parses as `a || (b && c)` (`&&` binds tighter
// than `||`), which would silently exempt the FIRST disjunct of every `||`-based ownership check
// below (the account-owner branch on `Project`/`ApiKey`) from the permission gate entirely. Caught
// by hand-reviewing this generator's own first draft output before it was committed, not by the
// drift-check test alone (which only proves the file matches what the generator computes, not that
// the generator computes something semantically correct) -- see the PR description.
//
// Field names are mechanically derived from `Permission::as_str()` by
// `rpc_authorize::permission_field_name` (e.g. `"budget:read-own"` -> `permBudgetReadOwn`); this
// block is a literal transcription of `Permission::ALL` in that same declaration order, printed by
// that function, not typed by hand permission-by-permission.
//
// KNOWN, ACCEPTED BEHAVIOR CHANGE (batch path only -- unary is byte-for-byte unchanged, still a
// clean 404): a caller hitting a budget op-id on `authz-api` inside a `/rpc/batch` envelope now
// gets that frame's `403 permission_denied` instead of `404 not_found`. `RpcScope` is a deployment
// fact (which binary is running), not a caller fact, so it genuinely IS safe to bake into the one
// envelope-cached context -- unlike a per-frame *permission requirement*, which varies by op-id and
// is correctly handled by each clause below instead. But cratestack's `authorize_procedure` can
// only ever return `Forbidden` on denial, never `NotFound` -- there is no schema-policy mechanism
// to reject before dispatch reaches policy evaluation, because `CratestackAuthProvider` is invoked
// once for the whole envelope and structurally cannot see individual frames to 404 them ahead of
// time. The refusal itself is unaffected (still fail-closed, still unreachable for a caller lacking
// the scope regardless of how many permissions they otherwise hold -- see
// `budget_gated_op_ids_are_unreachable_on_authz_api_even_for_an_admin`), and the only observable
// consequence is that a `403` on a `/rpc/batch` frame confirms the op-id EXISTS in the schema where
// a `404` previously did not -- negligible here, since every op-id in this schema is already public
// (there is no secret op-id whose mere existence this schema keeps hidden), but worth being
// explicit about rather than leaving unremarked.
//
// SECOND KNOWN, ACCEPTED BEHAVIOR DIFFERENCE (also batch-path-only): `model.*` `list`/`get` verbs'
// `@@allow("read", ...)` below compiles into the SQL `WHERE` clause itself, not a hard pre-check
// (cratestack-sqlx's `render/policy.rs`) -- a caller lacking read permission simply matches zero
// rows (empty list / not-found), never `403 permission_denied`, unlike `create`/`update`/`delete`
// verbs and every `procedure.*`, which DO hard-gate. Pre-existing upstream cratestack property this
// fix did not create; see `auth_provider.rs`'s module doc ("Two accepted, documented behavior
// differences") for the full explanation and the two tests that pin down both halves.
auth Principal {
  id String
  rpcScope String
  permAccountCreate Boolean
  permAccountRead Boolean
  permAccountUpdate Boolean
  permAccountDelete Boolean
  permAccountDisable Boolean
  permProjectCreate Boolean
  permProjectRead Boolean
  permProjectUpdate Boolean
  permProjectDelete Boolean
  permProjectDisable Boolean
  permProjectMember Boolean
  permApikeyCreate Boolean
  permApikeyRead Boolean
  permApikeyUpdate Boolean
  permApikeyDelete Boolean
  permApikeyRevoke Boolean
  permApikeyRotate Boolean
  permApikeyValidate Boolean
  permBudgetRead Boolean
  permBudgetReadOwn Boolean
  permBudgetSelfRefill Boolean
  permBudgetReview Boolean
  permBudgetGrant Boolean
  permBudgetRevoke Boolean
  permBudgetAuditRead Boolean
  permBudgetPolicyRead Boolean
  permBudgetPolicyWrite Boolean
  permBudgetPolicySimulate Boolean
  permBudgetPolicyActivate Boolean
  permSessionRevokeOwn Boolean
  permSessionRevoke Boolean
}

mixin AuditFields {
  createdAt DateTime @default(dbgenerated())
  updatedAt DateTime @default(dbgenerated())
}

// `@@paged` (bare form only, confirmed against cratestack source -- configurable paging modes
// aren't implemented yet) wraps every `list` route's response in
// `Page<T> { items, totalCount, pageInfo: { limit, offset, hasNextPage, hasPreviousPage } }`
// instead of a bare array, and runs a second count-only query per list call for `total_count`.
// Applied to all four models below. Known upstream gap, filed as
// https://github.com/cratestack/cratestack/issues/123: cratestack does not clamp `limit`/`offset`
// server-side (see `parse_model_list_query` -- `crates/cratestack-macros/src/axum/shared_support.rs`),
// so a caller can request an unbounded `limit`; if these lists become externally reachable with
// meaningfully large tables, a ceiling needs to live in `rpc_authorize.rs` or equivalent until
// upstream adds one.

model Account {
  @use(AuditFields)

  id String @id
  // Governance tier for usage under this account's own default project (the project has no
  // roster to hang a per-member quota on -- see `ProjectMember.quotaTier`). Validated against
  // the operator-configured tier catalog at write time (config, not DB), same pattern
  // `billingPlan`/`quotaTier` use elsewhere. Renamed/repurposed from the old `billingIdentity`
  // (moved to `Project.billingIdentity`, see below) -- not the same concept, a fresh field.
  //
  // `@readonly` (#379, completing #177/#375): the generic `model.Account.update` verb has no hook
  // for a runtime-configured catalogue check (cratestack 0.8.0's generated `validate()` is built
  // purely from static `@length`/`@range`/`@regex`/`@email`/`@uri`/`@iso4217` attributes -- none
  // can express "must be one of these env-driven ids"), so #375 could only wire `QuotaTiers::
  // is_allowed` into `createAccount`, leaving this settable-but-unvalidated via the generic verb.
  // `@readonly` drops it from the generated update input; `updateAccountDefaultQuota` below is now
  // the only write path after creation, matching the `status` pattern immediately below.
  //
  // Confirmed consequence, not just a theoretical one: `defaultQuota` was `Account`'s only
  // generically-settable field (`status` was already `@readonly`), so `model.Account.update` now
  // has ZERO settable fields left -- cratestack rejects every call to it, even from an otherwise
  // fully-authorized caller, with 422 "update input must contain at least one changed column"
  // (`crates/lightbridge-authz-rest/tests/rpc_it_tests.rs::rbac_gate_admin_succeeds_and_member_
  // viewer_reads_but_cannot_write` exercises this directly). The verb is left mapped rather than
  // denied -- removing it outright is an explicit maintainer decision per #379's own scope, not an
  // assumption to bake in here -- but callers should treat it as permanently non-functional today.
  defaultQuota String? @readonly
  // Server-managed lifecycle state: set only by the disable/enable procedures and the
  // DB `DEFAULT 'active'` (migrations/20260714000001). `@readonly` drops it from the
  // generated create/update inputs so a raw RPC caller cannot supply a born-suspended
  // status, matching `ApiKey.status` below.
  status String @readonly
  projects Project[] @relation(fields:[id],references:[accountId])

  // NOTE: no `@@allow("create", ...)`. Account creation stays exclusively through the
  // `createAccount` procedure (self-service explicit bootstrap, not implicit provisioning --
  // see ADR-0006), which also generates the account id; `model.Account.create` is denied
  // unconditionally at the RBAC layer too (crates/lightbridge-authz-rest/src/rpc_authorize.rs).
  //
  // NOTE: no `@@allow("delete", ...)` either. `deleteAccountPermanently` remains the only path;
  // per ADR-0006 there is no more membership/role concept to gate it with -- one account is one
  // person, so its hand-written SQL check becomes simply "the caller is this account" (updated
  // in the ADR-0006 follow-up procedure pass, not this schema/migration pass).
  @@audit
  @@paged
  @@allow("read", (id == auth().id) && auth().rpcScope == "crud" && auth().permAccountRead == true)
  @@allow("update", (id == auth().id) && auth().rpcScope == "crud" && auth().permAccountUpdate == true)
}

model Project {
  @use(AuditFields)

  id String @id
  accountId String
  name String
  allowedModels Json?
  defaultLimits Json
  billingPlan String
  // MOVED here from `Account` per ADR-0006: one project, one billing identity ("who's
  // paying"). Lets one account have several projects billed to different parties.
  billingIdentity String @unique
  // Pooled cap across everyone on the project, drawn from the same governance tier catalog as
  // `Account.defaultQuota`/`ProjectMember.quotaTier`. Validated at write time (config, not DB).
  //
  // `@readonly` (#379, completing #177/#375): same reasoning as `Account.defaultQuota` above --
  // neither the generic `model.Project.create` nor `model.Project.update` verb has a hook for a
  // runtime-configured catalogue check, so both were leaving this settable-but-unvalidated.
  // `@readonly` drops it from BOTH generated inputs; `setProjectQuota` below is now the only write
  // path (post-creation only -- a brand-new project starts with `projectQuota = NULL`, settable
  // afterward). `StoreRepo::create_project`'s own `project_quota` parameter has zero production
  // callers today (confirmed by #375's investigation) and stays that way -- generic `model.
  // Project.create` remains the only creation path, it just can no longer set this one field.
  projectQuota String? @readonly
  // Set once, server-side, by a `BEFORE INSERT` trigger (`migrations/20260725000001_default_
  // account_project.sql`) -- true only for an account's first-ever project. `@readonly` keeps it
  // out of the generic create/update inputs; unlike Account/ApiKey, Project creation was never
  // moved to a hand-written procedure (see `@@allow("create", ...)` below), so cratestack's
  // generic `model.Project.create` verb has no hook for this per-request "is this the account's
  // first project" computation -- the DB trigger is the only mechanism available. A partial
  // unique index (`projects_account_id_default_uidx`) backstops the race where two concurrent
  // first-project creates for the same brand-new account would otherwise both see zero existing
  // rows. Gates `@@allow("delete", ...)` below -- a default project can still be suspended
  // (disableProject) but never hard-deleted. Reassignable via the dedicated `setDefaultProject`
  // procedure below (hand-written SQL), which atomically unsets the account's current default
  // project before setting the new one -- the partial unique index above still backstops the
  // invariant even if two reassignments race.
  //
  // Per ADR-0006, this field also buys a structural invariant for free: nothing ever inserts a
  // `ProjectMember` row for a default project, so `members.some.accountId == auth().id` in the
  // `@@allow` predicates below is always false on it -- "no membership concept on the default
  // project" falls out of the data model, no `isDefault` branching needed anywhere in policy.
  isDefault Boolean @readonly
  // Server-managed lifecycle state, same contract as `Account.status` above: mutated only
  // by disable/enable procedures + DB `DEFAULT 'active'`, `@readonly` so it is absent from
  // the generic `model.Project.create`/`update` inputs.
  status String @readonly
  account Account @relation(fields:[accountId],references:[id])
  members ProjectMember[] @relation(fields:[id],references:[projectId])
  apiKeys ApiKey[] @relation(fields:[id],references:[projectId])

  @@audit
  @@paged
  @@allow("create", (account.id == auth().id) && auth().rpcScope == "crud" && auth().permProjectCreate == true)
  @@allow("read", (account.id == auth().id || members.some.accountId == auth().id) && auth().rpcScope == "crud" && auth().permProjectRead == true)
  @@allow("update", (account.id == auth().id || members.some.accountId == auth().id) && auth().rpcScope == "crud" && auth().permProjectUpdate == true)
  @@allow("delete", (isDefault != true && account.id == auth().id) && auth().rpcScope == "crud" && auth().permProjectDelete == true)
  // Lead-only mutations are NOT expressible as `@@allow` -- same class of problem ADR-0005 hit
  // with account roles: "the member row matching my subject must ALSO have role=lead" is a
  // compound condition on one related row, and cratestack's relation-quantifier policy can't
  // express it (confirmed by ADR-0005 reading the actual resolver source,
  // `cratestack-macros/src/policy/model/relation_path.rs`). Roster add/remove, role changes, and
  // quotaTier changes stay hand-written procedures below (`addProjectMember`,
  // `removeProjectMember`, `setProjectMemberRole`, `setProjectMemberQuotaTier`), ADR-0005's
  // pattern re-targeted at project leadership; `createApiKey` below is lead-gated the same way.
  // Allowlist edits (`allowedModels`) are not yet lead-gated by a dedicated procedure -- still
  // tracked as follow-up, see ADR-0006.
}

// Field-level immutability closes the gap the coarse RBAC gate cannot express on
// its own: a caller who legitimately holds `apikey:update` (and account
// membership) must still not be able to overwrite the security-sensitive columns
// that are supposed to be gated by the dedicated `apikey:rotate` / `apikey:revoke`
// / `apikey:create` capabilities. `@readonly` drops a field from BOTH the
// generated `CreateApiKeyInput` and `UpdateApiKeyInput` (it stays readable in the
// read/output model), and `@server_only` additionally masks the field from
// outbound JSON. So the generated `UpdateApiKeyInput` collapses to exactly
// `{ name, expiresAt }` -- matching the pre-migration `UpdateApiKey` DTO -- while
// `status`/`keyHash`/`billingPlan`/`revokedAt`/`keyPrefix`/`projectId`/telemetry
// remain server-managed (set only by the hand-written `createApiKey`/`rotateApiKey`/
// `revokeApiKey` procedures). `keyHash` is `@server_only` so it is never emitted on
// the wire, restoring the `#[serde(skip_serializing)]` guarantee the pre-migration
// `ApiKey` DTO had (the generic model read would otherwise leak the hash).
model ApiKey {
  @use(AuditFields)

  id String @id
  projectId String @readonly
  name String
  keyPrefix String @readonly
  keyHash String @unique @server_only
  status String @readonly
  expiresAt DateTime?
  lastUsedAt DateTime? @readonly
  lastIp String? @readonly
  revokedAt DateTime? @readonly
  deletedAt DateTime? @readonly
  billingPlan String @readonly
  project Project @relation(fields:[projectId],references:[id])

  // NOTE: no `@@allow("create", ...)`. Removing it fail-closes the generic
  // `model.ApiKey.create` RPC verb (a caller could otherwise supply
  // `keyHash`/`keyPrefix`/`billingPlan` directly instead of the server generating,
  // hashing, and billing-validating a secret). Key creation now goes exclusively
  // through the `createApiKey` procedure below, and `model.ApiKey.create` is also
  // denied unconditionally at the RBAC layer (crates/lightbridge-authz-rest/src/rpc_authorize.rs).
  @@soft_delete
  @@audit
  @@paged
  @@allow("read", (project.account.id == auth().id || project.members.some.accountId == auth().id) && auth().rpcScope == "crud" && auth().permApikeyRead == true)
  @@allow("update", (project.account.id == auth().id || project.members.some.accountId == auth().id) && auth().rpcScope == "crud" && auth().permApikeyUpdate == true)
  @@allow("delete", (project.account.id == auth().id || project.members.some.accountId == auth().id) && auth().rpcScope == "crud" && auth().permApikeyDelete == true)
}

// Relation target ONLY. The real `project_members` table (owned by
// migrations/<date>_create_project_members.sql) has a composite primary key
// (project_id, account_id) and no `id` column -- same shape as the removed
// `account_memberships` table it replaces. cratestack requires every model to
// declare exactly one scalar `@id` field, so `id` below is a synthetic field
// with no backing column in the real table. This model must never be handed
// to cratestack's migration generator/diff tool -- doing so would try to
// create an `id` column and a `project_members` table shape that does not
// match the hand-written migration. It exists solely so `.some`/`.every`/
// `.none` policy predicates on Project/ApiKey can traverse into it.
//
// cratestack-pg 0.4.13 added parser/migrate-layer support for composite keys
// (`@@id([projectId, accountId])`, cratestack/cratestack#145), which would match this table's
// real shape exactly and drop the synthetic `id` -- tried it for the predecessor
// `AccountMembership` model, but codegen (query builders, routing, generated clients)
// explicitly rejects it as not yet supported, tracked at cratestack/cratestack#136. Revisit
// once that lands; the synthetic-`id` workaround stays until then.
model ProjectMember {
  id String @id
  projectId String
  accountId String
  // "lead" | "member" (DB CHECK constraint). Gates roster add/remove, role changes, and
  // quotaTier changes via hand-written sqlx role checks in `addProjectMember`/
  // `removeProjectMember`/`setProjectMemberRole`/`setProjectMemberQuotaTier` below (see the
  // compound-condition limitation noted on `Project` above for why this isn't expressed as an
  // `@@allow` policy).
  role String
  // Per-member ceiling: how much *this specific person* may use on *this specific project*.
  // Settable only by the project's lead. Same governance tier catalog as
  // `Account.defaultQuota`/`Project.projectQuota`, validated at write time (config, not DB).
  quotaTier String?
  createdAt DateTime
  project Project @relation(fields:[projectId],references:[id])
  // `accountId` is deliberately a bare scalar with NO `account Account @relation`, mirroring how
  // the `AccountMembership` this replaces carried `subject` as a plain string. The DB-level FK to
  // `accounts` still exists -- it lives in the migration, not here, since this schema is
  // source-only and does not drive DDL (ADR-0003).
  //
  // The relation was present initially and has to stay out. `Account` and `Project` are already
  // directly connected (`Account.projects`), so declaring `ProjectMember.account` as well makes
  // `ProjectMember` a SECOND path between them. cratestack's relation codegen walks every acyclic
  // path through the relation graph to emit nested filter/order/include modules -- it guards
  // against cycles with a `visited` set of `model.field` keys, so this does not recurse forever,
  // but the number of distinct paths multiplies. That is enough to make the generated module large
  // enough to defeat rustc: `cargo check` on this crate consumed ~51 GB (16 GB RAM + 36 GB swap)
  // over 36 minutes and was still growing when the CI runner killed it.
  //
  // Nothing needs the relation: no `@@allow` here or elsewhere traverses `ProjectMember.account`
  // (they use this scalar, or reach the owner via `project.account`), the repository layer is
  // hand-written SQL against the column, and the generated client is not consuming it either.
  // `Account` deliberately has no `members ProjectMember[]` back-reference for the same reason.

  @@paged
  @@allow("read", accountId == auth().id || project.account.id == auth().id)
}

// Stale-tolerant dashboard aggregate only -- explicitly NOT used for any
// authorization or validation decision (see ADR-0003, "Materialized views").
// Refresh is explicit (runtime.views().account_summary().refresh().await),
// never automatic-on-write.
view AccountSummary from Account, Project, ApiKey {
  id String @id @from(Account.id)
  projectCount Int
  apiKeyCount Int
  activeApiKeyCount Int

  @@server_sql("SELECT a.id, COUNT(DISTINCT p.id)::int AS project_count, COUNT(DISTINCT k.id)::int AS api_key_count, COUNT(DISTINCT k.id) FILTER (WHERE k.status = 'active' AND k.deleted_at IS NULL)::int AS active_api_key_count FROM accounts a LEFT JOIN projects p ON p.account_id = a.id LEFT JOIN api_keys k ON k.project_id = p.id GROUP BY a.id")
  @@allow("read", (auth() != null) && auth().rpcScope == "crud" && auth().permAccountRead == true)
  @@materialized
}

type RotateApiKeyInput {
  keyId String
}

// Nests the real `ApiKey` model directly, matching the real
// `ApiKeySecret { api_key: ApiKey, secret: String, oauth2_url: Option<String> }` DTO shape
// (crates/lightbridge-authz-core/src/dto.rs). Previously flattened as scalars, because
// cratestack-pg 0.4.9-0.4.12's codegen for `type` blocks couldn't reference a model type by
// name as a field (`type` structs were emitted inside `cratestack_schema::types`, model
// structs in the sibling `cratestack_schema::models`, and the `type`-struct field generator
// never emitted the `super::`/`super::models::` qualifier the cross-module reference needed --
// confirmed by a real `include_server_schema!` compile failing with "cannot find type `ApiKey`
// in this scope"). Fixed in cratestack-pg 0.4.13 (cratestack/cratestack#147); un-flattened here
// now that it's adopted.
type ApiKeySecret {
  apiKey ApiKey
  secret String
  oauth2Url String?
}

mutation procedure rotateApiKey(args: RotateApiKeyInput): ApiKeySecret
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permApikeyRotate == true)

// Server-side account creation (ADR-0003 follow-up; re-scoped by ADR-0006). Replaces the
// now-denied generic `model.Account.create` verb -- kept as a procedure not because of any
// membership seeding anymore (ADR-0006 removed account-level membership entirely, so there is no
// second row to insert transactionally), but because the account `id` is no longer
// server-generated or caller-supplied: it IS the caller's JWT subject (`auth().id`), read
// straight off the bearer token, never trusted from the request body. Implemented as
// hand-written sqlx in the ProcedureRegistry impl (reusing `AuthzStoreImpl::create_account` ->
// `StoreRepo::create_account`); a second call for the same subject is `Error::Conflict`
// ("account already exists for this subject"), not an upsert. The caller supplies only
// `defaultQuota` (governance tier for the account's own default-project usage, validated against
// the operator-configured catalog at write time -- config, not DB; status defaults to 'active' at
// the DB level).
type CreateAccountInput {
  defaultQuota String?
}

mutation procedure createAccount(args: CreateAccountInput): Account
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permAccountCreate == true)

// Updates `Account.defaultQuota` post-creation (#379, completing #177/#375):
// `Account.defaultQuota` is `@readonly` above, so the generic `model.Account.update` verb can no
// longer set it -- this procedure is the only write path left. Shaped like `disableAccount`/
// `enableAccount` immediately below, not like `createAccount`: it carries an explicit `accountId`
// argument even though the schema's own `@@allow("update", id == auth().id)` on `Account` (dropped
// from the generic verb's own policy the same way it always applied) means only a self-update ever
// succeeds -- `id = accountId AND id = auth().id` is enforced in the hand-written SQL `WHERE`
// clause, same as those two procedures' `StoreRepo::set_account_status`. Implemented as
// hand-written sqlx in the ProcedureRegistry impl (`AuthzStoreImpl::update_account_default_quota`
// -> `StoreRepo::update_account_default_quota`), validating `defaultQuota` against the
// operator-configured catalog at write time (config, not DB) before the DB write, same
// pattern/error shape as `createAccount`'s own check.
type UpdateAccountDefaultQuotaInput {
  accountId String
  defaultQuota String?
}

mutation procedure updateAccountDefaultQuota(args: UpdateAccountDefaultQuotaInput): Account
  @allow(auth() != null)

// Server-side API-key creation (ADR-0003 follow-up). Replaces the now-denied generic
// `model.ApiKey.create` verb: the server generates the secret, hashes it, derives the
// prefix, and validates `billingPlan` against the operator-configured catalogue -- none
// of which the caller may supply. Input mirrors the pre-migration
// `POST /projects/{project_id}/api-keys` request (path `project_id` + body
// `{ name, expires_at, billing_plan }`); the pre-migration `CreateApiKey` DTO carried no
// `allowed_models` (that lives on Project), so this input does not either. Implemented as
// hand-written sqlx in the ProcedureRegistry impl (reusing `AuthzStoreImpl::create_api_key`).
//
// Lead-gated (handoff recommendation #3, accepted): unlike `Project`'s coarse read/update
// `@@allow` (any member may read/update), minting a new key requires the caller to be either the
// project's account owner (`projects.account_id = auth().id`) or hold a `project_members` row
// with `role = 'lead'` on that project. Same compound-condition limitation as everywhere else on
// this surface (a single related `project_members` row must match BOTH `accountId == auth().id`
// AND `role == "lead"`, which cratestack's relation-quantifier policy can't express as one
// `@@allow` predicate -- see the `Project`/`ProjectMember` model comments), so the lead check is
// hand-written SQL inside this procedure rather than schema policy. `@allow(auth() != null)`
// below only asserts an authenticated caller.
type CreateApiKeyInput {
  projectId String
  name String
  expiresAt DateTime?
  billingPlan String
}

mutation procedure createApiKey(args: CreateApiKeyInput): ApiKeySecret
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permApikeyCreate == true)

// The operator-configured billing-plan catalogue (`config.billing.plans`, `Billing` in
// `lightbridge-authz-core`), read-only. Added so a caller building a `createApiKey` UI can build a
// real selector instead of hardcoding plan ids client-side -- before this procedure, the only place
// the catalogue was exposed anywhere on the wire was the MCP tool description string
// (`LightbridgeMcpHandler::advertised_tools` appends "Valid billing_plan ids: ..." to
// `create-api-key`'s description), which is not machine-readable and not reachable from the RPC
// surface `createApiKey` itself lives on. `limits` mirrors `BillingLimits` field-for-field; an
// absent field there means "no limit" (see that struct's doc comment) and stays absent here rather
// than being coerced to a sentinel. Gated at the same `apikey:create` permission as `createApiKey`
// (`rpc_authorize.rs`) -- a caller who cannot mint a key has no use for the plan list either, and
// this keeps the two procedures' authorization stories identical rather than inventing a new,
// looser permission for a one-field read.
type BillingPlanLimits {
  requestsPerSecond Int?
  requestsPerDay Int?
  requestsPerMonth Int?
  concurrentRequests Int?
}

type BillingPlanInfo {
  id String
  name String
  limits BillingPlanLimits?
}

type ListBillingPlansInput {
}

procedure listBillingPlans(args: ListBillingPlansInput): BillingPlanInfo[]
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permApikeyCreate == true)

// The operator-configured AI-model catalogue (`config.models`, `ModelCatalog` in
// `lightbridge-authz-core`), read-only. Lets a `Project.allowedModels` editor (e.g. a checkbox
// picker in the self-service UI) render real model ids instead of hardcoding a list client-side --
// the RBAC permission map and the pre-#283 `allowed_models` encoding bug are both examples of
// exactly the kind of silent drift a hardcoded frontend mirror produces. Gated at the same
// `project:update` permission `updateProject` uses for editing `allowedModels` itself (see
// `rpc_authorize.rs`) -- a caller who cannot edit a project's allowlist has no use for the
// catalogue either. NOT a validation source: `Project.allowedModels` stays an unvalidated
// free-form list at write time (see that field's own doc comment) -- this procedure is a read-only
// display aid, not a server-side allowlist gate; making `updateProject` validate against this
// catalogue would be a separate, larger change.
type ModelCatalogEntry {
  id String
  name String
}

type ListModelCatalogInput {
}

procedure listModelCatalog(args: ListModelCatalogInput): ModelCatalogEntry[]
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectUpdate == true)

type RevokeApiKeyInput {
  keyId String
}

mutation procedure revokeApiKey(args: RevokeApiKeyInput): ApiKey
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permApikeyRevoke == true)

// Project roster mutations (ADR-0006 follow-up to ADR-0003 item 4; replaces the retired
// `addAccountMember`/`removeAccountMember`/`setAccountMemberRole` trio now that membership lives
// on `Project`, not `Account`). Hand-written sqlx in the ProcedureRegistry impl (not generated
// CRUD): `project_members` is a relation-target-only model here (composite PK, no `id` column),
// so it has no generated create/update/delete verb, and role/lead gating can't be expressed as an
// `@@allow` policy -- the same compound-condition limitation documented on `Project` above
// (`cratestack-macros/src/policy/model/relation_path.rs` resolves each dotted policy path to
// exactly one target field per relation hop, so "the member row matching my subject must ALSO
// have role=lead" can't be one joint `@@allow` condition). The `@allow(auth() != null)` gate
// below only asserts an authenticated caller; the real authorization lives in the hand-written
// SQL: every mutation here requires the acting subject to be the project's account owner
// (`projects.account_id = auth().id`) or already hold a `project_members` row with `role =
// "lead"` on that project -- a plain "member" cannot add/remove/promote members or change quota
// tiers, only leads and the owning account can.
type AddProjectMemberInput {
  projectId String
  accountId String
  // Optional; defaults to "member" if omitted.
  role String?
}

mutation procedure addProjectMember(args: AddProjectMemberInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectMember == true)

type RemoveProjectMemberInput {
  projectId String
  accountId String
}

mutation procedure removeProjectMember(args: RemoveProjectMemberInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectMember == true)

type SetProjectMemberRoleInput {
  projectId String
  accountId String
  role String
}

mutation procedure setProjectMemberRole(args: SetProjectMemberRoleInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectMember == true)

// Governance tier for this specific member's usage on this specific project (see
// `ProjectMember.quotaTier` above). Validated against the operator-configured tier catalog at
// write time (config, not DB), same pattern as `Account.defaultQuota`/`Project.projectQuota`.
type SetProjectMemberQuotaTierInput {
  projectId String
  accountId String
  quotaTier String?
}

mutation procedure setProjectMemberQuotaTier(args: SetProjectMemberQuotaTierInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectMember == true)

// The roster's READ path, and the only one there is. The four mutations above all return
// `Project`, so without this the roster could be changed but never listed.
//
// It has to be a procedure rather than the generic `model.ProjectMember.list` verb for two
// independent reasons, either of which alone would be disqualifying:
//   1. `ProjectMember.id` is synthetic. The real `project_members` table is keyed
//      `PRIMARY KEY (project_id, account_id)` and has no `id` column at all (the field exists
//      only because cratestack requires exactly one scalar `@id`), so a generated `SELECT id, ...`
//      would reference a column that does not exist.
//   2. `model.ProjectMember.*` is deliberately fail-closed in `rest/src/rpc_authorize.rs` and
//      asserted so by test, because the model is policy-traversal-only.
// The hand-written SQL therefore synthesises the id from the composite key.
//
// Declared `procedure` (not `mutation procedure`) so it parses as `ProcedureKind::Query` -- this
// reads, it does not write. Authorization is in the SQL and is deliberately WIDER than the
// mutations': any member of the project may read the roster, plus the owning account. Leads are
// not privileged here; knowing who you are working with is not a management capability.
type ListProjectRosterInput {
  projectId String
}

procedure listProjectRoster(args: ListProjectRosterInput): ProjectMember[]
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectMember == true)

// Replaces the now-denied generic `model.Account.delete` verb (see the `Account` model's
// `@@allow` comments). Per ADR-0006 there is no more owner/role concept to gate this with -- one
// account is one person, so the hand-written SQL check simplifies to "the caller is this account"
// (`accounts.id = auth().id`). Cascades to projects (and transitively each project's api keys and
// `project_members` rows) via the existing `ON DELETE CASCADE` foreign keys, same as the
// pre-migration hand-written delete did.
type DeleteAccountPermanentlyInput {
  accountId String
}

mutation procedure deleteAccountPermanently(args: DeleteAccountPermanentlyInput): Account
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permAccountDelete == true)

// Account / project suspension (data-plane authorization; see docs/rbac.md). Disabling sets
// `status = 'suspended'`, which the `api_key_validation` view cascades so every key beneath a
// suspended account/project immediately fails validation; enabling restores `status = 'active'`.
// Hand-written sqlx wrappers over `StoreRepo::set_account_status` / `set_project_status`, so the
// authorization check is enforced in SQL as in the rest of the repo surface: `disableAccount`/
// `enableAccount` require the caller to be the account itself (`accounts.id = auth().id`, per
// ADR-0006 -- no more owner/role concept); `disableProject`/`enableProject` require the caller to
// be the project's account owner or a `project_members` row on that project. The
// `@allow(auth() != null)` gate only asserts an authenticated caller; the coarse
// `account:disable` / `project:disable` capability is enforced by the RBAC layer.
type AccountStatusInput {
  accountId String
}

mutation procedure disableAccount(args: AccountStatusInput): Account
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permAccountDisable == true)

mutation procedure enableAccount(args: AccountStatusInput): Account
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permAccountDisable == true)

type ProjectStatusInput {
  projectId String
}

mutation procedure disableProject(args: ProjectStatusInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectDisable == true)

mutation procedure enableProject(args: ProjectStatusInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectDisable == true)

// Reassign the default project (escape hatch for the "default can never be hard-deleted" policy
// above -- without this, the first project an account ever gets is permanently undeletable).
// Hand-written sqlx in `StoreRepo::set_default_project`: atomically unsets the account's current
// default project before setting the new one inside a single transaction, so the "at most one
// default" invariant (backed by `projects_account_id_default_uidx`) never observes two rows true
// (or zero) at once, and rejects (NotFound) a target that doesn't belong to the caller's account.
// The `@allow(auth() != null)` gate only asserts an authenticated caller; the coarse
// `project:update` capability is enforced by the RBAC layer, and the real account-ownership check
// lives in the hand-written SQL, same pattern as disableProject.
type SetDefaultProjectInput {
  projectId String
}

mutation procedure setDefaultProject(args: SetDefaultProjectInput): Project
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permProjectUpdate == true)

// Sets `Project.projectQuota` post-creation (#379, completing #177/#375): `Project.projectQuota`
// is `@readonly` above, so neither the generic `model.Project.create` nor `model.Project.update`
// verb can set it any more -- this procedure is the only write path left. A brand-new project
// therefore always starts with `projectQuota = NULL` (always valid -- see the field's own doc
// comment); this is where it gets set afterward. Authorization mirrors `model.Project.update`'s
// own dropped `@@allow` policy exactly (`account.id == auth().id || members.some.accountId ==
// auth().id` -- the project's account owner or ANY roster member, NOT lead-gated like the
// `ProjectMember.quotaTier` roster procedures below), enforced in hand-written SQL
// (`StoreRepo::set_project_quota`, mirroring `set_project_status`'s WHERE clause) since the
// `@allow(auth() != null)` gate below only asserts an authenticated caller; the coarse
// `project:update` capability is enforced by the RBAC layer. Validates `projectQuota` against the
// operator-configured catalog at write time (config, not DB) before the DB write, same
// pattern/error shape as `createAccount`'s `defaultQuota` check.
type SetProjectQuotaInput {
  projectId String
  projectQuota String?
}

mutation procedure setProjectQuota(args: SetProjectQuotaInput): Project
  @allow(auth() != null)

// Budget policy lifecycle (ADR-0007; storage in `lightbridge-authz-budget`'s `PolicyStore`).
// `activePolicyRevision` is the revision genuinely serving `evaluate()` calls right now -- not
// necessarily the one most recently activated, since a rejected load leaves the previous
// revision in force (see `PolicyStore::activate`/`activate_by_revision_id`).
type BudgetPolicyStatus {
  policySetId String
  activePolicyRevision String
}

// Activates a budget policy: either brand-new rule data (`ruleDataJson`) or a rollback to an
// already-existing revision (`revisionId`) -- `docs/runbooks/roll-back-a-budget-policy.md`'s
// rollback flow needs the latter, since resubmitting the same rule data through the "new
// revision" path would collide with the revisions table's uniqueness constraint. Exactly one of
// the two must be supplied; the procedure implementation validates this and rejects both-or-
// neither with a clear `BadRequest`. `@allow(auth() != null)` only asserts an authenticated
// caller -- there is no per-tenant ownership check here (budget policy is a single, platform-wide
// singleton, not owned by any particular account), so the real authorization is entirely the
// coarse `budget:policy-activate` RBAC gate (crates/lightbridge-authz-rest/src/rpc_authorize.rs).
type ActivateBudgetPolicyInput {
  policySetId String
  ruleDataJson String?
  revisionId String?
}

mutation procedure activateBudgetPolicy(args: ActivateBudgetPolicyInput): BudgetPolicyStatus
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetPolicyActivate == true)

// Reports the revision genuinely serving `evaluate()` calls right now -- not the one someone most
// recently tried to activate, which may have been rejected and left the previous one in force
// (`docs/runbooks/roll-back-a-budget-policy.md` step 0 depends on this distinction). Reads the
// live in-memory engine state directly, no database round-trip needed. Gated at
// `budget:policy-read`, coarser than `budget:policy-activate` -- reading status should not
// require the ability to change it.
type GetBudgetPolicyStatusInput {
  policySetId String
}

procedure getBudgetPolicyStatus(args: GetBudgetPolicyStatusInput): BudgetPolicyStatus
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetPolicyRead == true)

// Obligations a Decision attaches beyond auto/deny (ADR-0007's decision contract). Mirrors
// `lightbridge_authz_budget::decision::Obligations` field-for-field: the one obligation kind
// that's textually justified today is which role must review a `manual_review` decision.
type Obligations {
  requiredApproverRole String?
}

// The one decision shape every policy engine returns (ADR-0007). Mirrors
// `lightbridge_authz_budget::decision::Decision` field-for-field. `effect` carries the
// snake_case wire value of `lightbridge_authz_budget::Effect` (that Rust enum already derives
// `#[serde(rename_all = "snake_case")]`, e.g. `"auto_approve"`/`"manual_review"`/`"deny"`) as a
// plain `String` rather than a schema-level enum: no enum-like field exists elsewhere in this
// schema to confirm cratestack's representation for one, so a `String` carrying the exact wire
// value already produced by the Rust `Serialize` impl is the lowest-risk choice -- a caller reads
// the same string a direct `serde_json` serialization of `Effect` would produce, no separate
// mapping to keep in sync by hand.
type Decision {
  effect String
  approvedAmountMicros String
  maximumAmountMicros String
  reasonCodes String[]
  matchedRuleIds String[]
  policyRevision String
  obligations Obligations
}

// Evaluates a proposed rule-data policy against a caller-supplied scenario, entirely in memory
// -- no database read or write of any kind (see PolicyStore/RuleDataEngine; this procedure never
// touches either). "What would this policy decide for this account?" without granting anything,
// without persisting the proposed rule data, and without touching the currently active policy at
// all. `scenarioJson` is a JSON-encoded `Facts` (see crates/lightbridge-authz-budget/src/facts.rs
// for the shape -- `Serialize`/`Deserialize` derived specifically so this procedure can accept
// it). `requestedAmountMicros`, and the `Decision` fields that carry `i64` micro-USD amounts
// (`approvedAmountMicros`/`maximumAmountMicros`), are all passed/returned as decimal strings --
// matching `ruleDataJson`'s existing string-encoding precedent elsewhere in this schema -- rather
// than the schema's native `Int`. Checked directly against cratestack's own codegen
// (`crates/cratestack-macros/src/shared/types.rs`): `Int` maps to a full-range Rust `i64`, so the
// *Rust* side is safe, but the generated TypeScript client types `Int` as a bare `number`
// (`crates/cratestack-client-typescript/src/types.rs`), a JS `double` that silently loses
// precision above 2^53 -- exactly the class of client-side truncation risk `ruleDataJson`'s own
// string-encoding already avoids for large values. There is no existing large-integer `Int`
// field anywhere in this schema to point to as a safe precedent, so this follows the
// string-encoding pattern rather than guessing that a native `Int` is safe here.
type SimulateBudgetPolicyInput {
  ruleDataJson String
  scenarioJson String
  requestedAmountMicros String
}

// Gated at `budget:policy-simulate` (`Permission::BudgetPolicySimulate`), distinct from both
// `budget:policy-read` and `budget:policy-activate` -- simulating a proposed policy is neither
// "read what's active" nor "change what's active". `@allow(auth() != null)` only, matching
// `activateBudgetPolicy`/`getBudgetPolicyStatus`: this is a stateless, platform-wide capability,
// not scoped to any account or policy set (note there is deliberately no `policySetId` argument
// here at all -- simulation never reads or writes any stored policy set, so there is nothing to
// scope it to).
procedure simulateBudgetPolicy(args: SimulateBudgetPolicyInput): Decision
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetPolicySimulate == true)

// Self-service refill and the admin review queue (#191, PR 3.4) -- the RPC surface over
// `lightbridge_authz_budget::refill::RefillService`/`review::ReviewService`. Mirrors
// `lightbridge_authz_budget::augmentation::AugmentationRequest` field-for-field (see that module
// for the authoritative shape); this type is the request/decision ledger row for ONE refill
// attempt, auto-approved or queued alike -- as distinct from `Decision` above, which is
// `simulateBudgetPolicy`'s stateless, nothing-persisted evaluation result.
//
// `requestedAmountMicros`/`approvedAmountMicros` are decimal strings, the same 64-bit-safety
// rationale `SimulateBudgetPolicyInput`/`Decision` already established above (cratestack's `Int`
// is a full-range Rust `i64` server-side but a lossy JS `number` in the generated TypeScript
// client past 2^53).
//
// `status`/`policyEffect`/`requestedTier` are plain `String`s carrying their Rust `Display`/serde
// wire values, matching `Decision.effect`'s own precedent above -- `AugmentationStatus` and
// `Effect` both already derive stable snake_case (`Effect`) or hand-written (`AugmentationStatus
// ::as_str`) string forms; a schema-level enum would be a second, hand-maintained mapping of the
// same values with no existing precedent in this schema to justify the extra machinery.
//
// `policyReasonCodes`/`matchedRuleIds` are required `String[]`, not `String[]?`: cratestack's own
// type-reference grammar (`cratestack-parser`'s `TypeArity`) only allows a field to be a List OR
// Optional, never both, so a nullable array cannot be expressed in this schema language at all.
// This is not a loss in practice -- both fields are `Option<Vec<String>>` in the Rust domain type
// only because they are unset for the fleeting instant between `AugmentationRepo::create` and the
// first `record_decision` call; every procedure below only ever returns a request AFTER
// `record_decision`/`record_review` has run (see `RefillService::request_refill`/
// `ReviewService::approve`/`reject`), at which point both fields are always `Some(vec)` (possibly
// empty, never absent). The conversion in `lightbridge-authz-rest` maps that `None` case (which a
// caller of this RPC surface can never actually observe) to an empty list defensively rather than
// treating it as reachable.
type AugmentationRequest {
  id String
  budgetAccountId String
  accountId String
  projectId String?
  period String
  requestedTier String
  requestedAmountMicros String
  status String
  policyEffect String?
  policyReasonCodes String[]
  matchedRuleIds String[]
  policyRevision String?
  approvedAmountMicros String?
  grantId String?
  idempotencyKey String?
  reviewedBy String?
  rejectionReason String?
  createdAt DateTime
  reviewedAt DateTime?
}

// One page of `AugmentationRequest` rows (#296/#295) -- the same `{ entries, nextCursor }` shape
// `BudgetGrantPage` already established, reused verbatim rather than inventing a second
// page-shape convention for the same "cursor by createdAt, never by id" contract (ADR-0039).
// Shared by both `listPendingAugmentationRequests` and `listMyAugmentationRequests` below even
// though the two order their pages in opposite directions (see each procedure's own doc comment
// for why) -- `nextCursor` means the same thing either way: "pass this back to continue the same
// walk", `null` when the page came back short of a full page (nothing further to page to).
type AugmentationRequestPage {
  entries AugmentationRequest[]
  nextCursor DateTime?
}

// Self-service refill (#191's own reason this epic exists): a user asks for more budget for
// `budgetAccountId`/`period`, and `RefillService::request_refill` decides -- immediately (auto
// grant), or by queuing for a human (`pending_review`) -- without anyone hand-editing config.
// `period` is the `'YYYY-MM'` calendar-month string (`lightbridge_authz_budget::Period`).
// `idempotencyKey`, when supplied, makes a genuine client retry return the SAME
// `AugmentationRequest` rather than evaluating the request a second time (see
// `RefillService::find_existing`).
//
// Gated at `budget:self-refill` (`Permission::BudgetSelfRefill`). `@allow(auth() != null)` only
// -- same pattern as the rest of the budget domain (`activateBudgetPolicy` et al.): no per-tenant
// ownership check at the schema-policy layer, because the real authorization is the coarse RBAC
// permission gate (`crates/lightbridge-authz-rest/src/rpc_authorize.rs`).
//
// KNOWN GAP (see this PR's description for the full investigation): #191's own acceptance
// criteria require refusing this operation for an internal/API-key-derived caller, refills being
// OIDC-human-only. That refusal is NOT implemented in this PR -- there is no reliable,
// already-plumbed-through signal on this RPC surface today that distinguishes an OIDC-human
// caller from an internal/API-key-derived one (see `Procedures::request_budget_refill`'s own doc
// comment, and this PR's description, for exactly what was checked and why).
//
// `requestedAmountMicros` (ADR-0015): the caller-chosen amount, checked against the active
// policy's offered set (`MyBudgetRefillLadder.allowedAmountsMicros`) before evaluation.
// Deliberately optional and additive, NOT a replacement for the pre-ADR-0015 shape: omitting it
// preserves exactly today's behavior (`current_tier.next()`), so a live client that has not yet
// redeployed to send it keeps working unchanged against this same backend deploy. Tracked for
// removal (making it required, dropping the derivation) once every caller sends it -- same
// follow-up as `MyBudgetRefillLadder.ladder` below.
type RequestBudgetRefillInput {
  budgetAccountId String
  accountId String
  projectId String?
  period String
  idempotencyKey String?
  requestedAmountMicros String?
}

mutation procedure requestBudgetRefill(args: RequestBudgetRefillInput): AugmentationRequest
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetSelfRefill == true)

// Read-only companion to `requestBudgetRefill`: where the caller currently sits on ADR-0008's
// ladder for `period`, and what the next refill would grant *if* a submitted request is later
// approved. Unlike `AugmentationRequest.requestedTier` (only known after submitting), this can be
// shown before the caller ever clicks refill. Deliberately visibility only -- no reason codes, no
// cap/deny prediction; `requestBudgetRefill` alone decides what actually happens (see
// `RefillService::refill_status`'s own doc comment). `nextTier`/`nextTierAmountMicros` are `null`
// exactly when the caller is already on the top rung (`b-1000`).
//
// ⚠️ ADR-0015 superseded the "caller chooses nothing" model this type was originally built
// under (see the removed paragraph this comment used to carry, and ADR-0015 itself for the full
// reversal and why converse-frontends#148's original objection no longer applies -- policy still
// gates every requested amount). `currentTier`/`currentTierAmountMicros`/`nextTier`/
// `nextTierAmountMicros`/`ladder` are kept BYTE-FOR-BYTE as before ADR-0015 -- converse-
// frontends#185 is live in production reading exactly this shape, and deploying a backend that
// dropped or changed these fields would break it immediately. Do not remove or reshape them
// until a converse-frontends PR has switched to `allowedAmountsMicros` and deployed; then remove
// in a follow-up (tracked alongside `RequestBudgetRefillInput.requestedAmountMicros` above).
type BudgetLadderRung {
  tier String
  amountMicros String
}

type MyBudgetRefillLadder {
  budgetAccountId String
  period String
  currentTier String
  currentTierAmountMicros String
  nextTier String?
  nextTierAmountMicros String?
  ladder BudgetLadderRung[]
  // ADR-0015: the self-service refill amounts currently offered by the active policy, strictly
  // ascending micro-USD strings (e.g. `["6000000", "15000000", "30000000"]` for $6/$15/$30).
  // This is the source of truth going forward for what `requestBudgetRefill.requestedAmountMicros`
  // may legally be -- `ladder` above is a frozen pre-ADR-0015 snapshot, not this.
  allowedAmountsMicros String[]
}

type GetMyBudgetRefillLadderInput {
  period String
}

// Gated at the SAME `budget:self-refill` permission as `requestBudgetRefill` itself, not the
// broader `budget:read-own` `getMyBudgetBalance`/`listMyBudgetGrants` share -- this exists to serve
// the one screen that also calls `requestBudgetRefill`, mirroring `listBillingPlans`'s "read-only
// companion gated at the mutation's own permission" precedent
// (`crates/lightbridge-authz-rest/src/rpc_authorize.rs`'s doc comment on that entry) rather than
// inventing a new, looser permission for a one-screen read.
procedure getMyBudgetRefillLadder(args: GetMyBudgetRefillLadderInput): MyBudgetRefillLadder
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetSelfRefill == true)

// The admin review queue's read path (#191, PR 3.3's `ReviewService::list_pending`; pagination
// added by #296). `budgetAccountId: String?` mirrors `list_pending`'s own `Option<&str>` scoping
// precisely: omitted/`null` lists the whole cross-account queue (a global admin view), `Some`
// scopes to one account's pending requests. Gated at `budget:review` (`Permission::BudgetReview`),
// same permission as the two mutations below -- reading the queue and acting on it are both "the
// reviewer capability" here, unlike the budget-policy pair above where read and write are
// deliberately split into two permissions; there is no separate "read the review queue"
// capability in RFC-0001's sketch to split it into.
//
// #296: paginated by `createdAt`, never by id (ADR-0039), the same house rule
// `listMyBudgetGrants`/`listBudgetGrants` already follow. This queue is deliberately kept
// **oldest-first** (`ORDER BY created_at ASC` in `AugmentationRepo::list_pending_review` -- a
// queue, not a stack: the request that has waited longest surfaces first) -- #296's own
// acceptance criteria require "no cursor supplied" to keep matching that existing "from the
// start" behavior, so this is not a place to also flip the ordering. Because the walk is
// oldest-first, the cursor field is named `after` rather than `listMyBudgetGrants`'s `before` --
// pass `nextCursor` back as `after` to continue toward newer requests, the correct direction for
// an ascending walk. This is a deliberate, documented divergence from `listMyBudgetGrants`'s
// `before`/DESC convention, not an oversight: mirroring that field name here while keeping ASC
// ordering would silently invert what the field means without any signal in the schema itself.
type ListPendingAugmentationRequestsInput {
  budgetAccountId String?
  after DateTime?
  limit Int?
}

procedure listPendingAugmentationRequests(args: ListPendingAugmentationRequestsInput): AugmentationRequestPage
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetReview == true)

// A caller's own `AugmentationRequest` history (#295's remaining half -- `getMyBudgetBalance`/
// `listMyBudgetGrants` shipped the balance/ledger half in PR #325). Returns every request the
// caller has ever submitted, in ANY status (`pending_review`, `auto_approved`, `approved`,
// `denied`, ...) -- not scoped to `pending_review` the way `listPendingAugmentationRequests` is,
// and not reviewer-only. No target field at all, the same structural guarantee
// `getMyBudgetBalance`/`listMyBudgetGrants` already give: the target is always the caller's own
// budget account (`auth().id`), never a caller-supplied id, which is what makes it structurally
// impossible for this procedure to read anyone else's requests. Gated at `budget:read-own`
// (`Permission::BudgetReadOwn`), not `budget:review` -- seeing your own request history is the
// same "see your own budget" capability `getMyBudgetBalance`/`listMyBudgetGrants` already gate
// there, not the reviewer capability.
//
// Paginated the same shape as `listPendingAugmentationRequests` above (`AugmentationRequestPage`,
// cursor by `createdAt`, never by id per ADR-0039) but ordered newest-first with a `before`
// cursor, matching `listMyBudgetGrants`/`listBudgetGrants`'s own convention exactly -- unlike the
// admin queue above, there is no pre-existing "oldest-first" contract for this brand-new
// procedure to preserve, so it follows the closest sibling precedent (the other `budget:read-own`
// list procedure) rather than the admin queue's ASC/`after` shape.
type ListMyAugmentationRequestsInput {
  before DateTime?
  limit Int?
}

procedure listMyAugmentationRequests(args: ListMyAugmentationRequestsInput): AugmentationRequestPage
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetReadOwn == true)

// Approves a `pending_review` request: grants the requested amount and records the outcome
// (`ReviewService::approve`). Concurrency-safe against a racing `approve`/`reject` on the same
// `requestId` -- see that method's own doc comment for the advisory-lock design. Gated at
// `budget:review`.
type ApproveAugmentationRequestInput {
  requestId String
}

mutation procedure approveAugmentationRequest(args: ApproveAugmentationRequestInput): AugmentationRequest
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetReview == true)

// Rejects a `pending_review` request: no grant, just the review outcome plus a mandatory reason
// (`ReviewService::reject`). `reason` is a non-optional schema field -- the mandatory-reason rule
// is already enforced at runtime by `ReviewService::reject`/`AugmentationRepo::record_review`
// (#191's own implementation note: "a rejection without a visible reason turns into a support
// conversation"), but making the schema field non-optional too means a caller omitting it
// entirely gets a clean schema-validation error before the request ever reaches the procedure,
// rather than relying solely on the runtime check to catch it. Gated at `budget:review`.
type RejectAugmentationRequestInput {
  requestId String
  reason String
}

mutation procedure rejectAugmentationRequest(args: RejectAugmentationRequestInput): AugmentationRequest
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetReview == true)

// Refresh-token session revocation. There was previously no way to kill a live session short of a
// manual SQL UPDATE against `exchange_refresh_tokens` in prod -- these two procedures are the
// operator-facing surface over the same mechanism RFC 7009's `POST /oauth2/revoke`
// (`crates/lightbridge-authz-rest/src/token_exchange.rs`) uses for a single token: flipping
// `status` from `active` to `revoked`, which `find_active_exchange_refresh_token`/
// `consume_exchange_refresh_token` both already filter on, so it takes effect on the very next
// refresh attempt.
//
// Split into two permissions, same shape as the self-refill/review split above: a caller managing
// their own sessions is a distinct capability from an operator managing someone else's
// (`session:revoke-own` vs `session:revoke`, `docs/rbac.md`). Both are `@allow(auth() != null)`
// only -- no per-tenant `@@allow` ownership predicate makes sense here (there is no "owning
// account" relation on a bare subject string the way there is on `Project`/`ApiKey`), so the real
// authorization for both is entirely the RBAC permission gate
// (`crates/lightbridge-authz-rest/src/rpc_authorize.rs`). `revokeOwnSessions` takes no target
// subject at all -- the subject to revoke is `auth().id`, never a caller-supplied value, which is
// what makes it structurally impossible for this procedure to be aimed at anyone but the caller.
type SessionRevocationResult {
  revokedCount Int
}

type RevokeOwnSessionsInput {
  reason String?
}

mutation procedure revokeOwnSessions(args: RevokeOwnSessionsInput): SessionRevocationResult
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permSessionRevokeOwn == true)

// The offboarding kill switch: an operator revokes every active session for `accountId` (which is
// that subject's JWT `sub`, per ADR-0006 -- `accounts.id` holds it verbatim). Gated at
// `session:revoke`, held only via `lightbridge-admin`'s `*` in the default role mapping.
type RevokeSubjectSessionsInput {
  accountId String
  reason String?
}

mutation procedure revokeSubjectSessions(args: RevokeSubjectSessionsInput): SessionRevocationResult
  @allow((auth() != null) && auth().rpcScope == "crud" && auth().permSessionRevoke == true)

// Direct budget-balance/ledger reads (docs/rbac.md "Budget permissions (remaining five reserved,
// not yet gating any operation)" -- this section wires up the reads). `budget_balances` is
// maintained transactionally on every grant (`BudgetRepo::grant`) but had no reader at all before
// this; `budget_grants` is the append-only ledger (ADR-0009) and was equally unreadable.
//
// Self vs admin is split into TWO PAIRS of procedures rather than one procedure with an
// optional/defaulted target, the same shape `revokeOwnSessions`/`revokeSubjectSessions` already
// established for session revocation: `getMyBudgetBalance`/`listMyBudgetGrants` take no target
// subject/account at all -- the target is always the caller's own budget account (mirroring
// `RevokeOwnSessionsInput` having no subject field) -- gated at `budget:read-own`, a permission
// added specifically so a caller can see their own budget without also being handed the ability
// to read anyone else's (see `Permission::BudgetReadOwn`'s own doc comment for why granting
// `budget:read` broadly to satisfy this would be a real privilege escalation, not a shortcut).
// `getBudgetBalance`/`listBudgetGrants` take an explicit `budgetAccountId`, gated at the admin
// `budget:read`/`budget:audit-read` respectively -- reading a balance and reading the ledger
// history behind it are kept as separate permissions, mirroring the `budget:policy-read` vs
// `budget:policy-write` precedent of not collapsing "read" and "the more detailed read" into one
// grant.
//
// All four are `@allow(auth() != null)` only, same pattern as the rest of the budget domain --
// there is no per-tenant `@@allow` predicate that could express "budgetAccountId belongs to
// auth().id" here (ADR-0008: `budget_account_id` is always identical to `account_id`, i.e. the
// caller's own JWT `sub` for the self-scoped pair, and cratestack's schema policy language has no
// way to compare an arbitrary string *input* field against `auth().id` for the admin pair
// either), so the coarse RBAC permission gate (`crates/lightbridge-authz-rest/src/rpc_authorize.rs`)
// is the entire authorization story, exactly as documented for `activateBudgetPolicy` et al.
//
// Amount fields are decimal strings, not the schema's native `Int` -- the same 64-bit-safety
// rationale `Decision`/`AugmentationRequest` above already established (cratestack's `Int` is a
// full-range `i64` server-side but a lossy JS `number` past 2^53 in the generated TypeScript
// client). Counts (`selfServiceGrantCount`/`automaticGrantCount`/`version`) stay `Int` -- they are
// small counters, not monetary amounts, matching `SessionRevocationResult.revokedCount`'s own
// precedent just above.
type BudgetBalance {
  budgetAccountId String
  period String
  baseTotalMicros String
  selfServiceTotalMicros String
  adminTotalMicros String
  automaticTotalMicros String
  refundTotalMicros String
  effectiveBudgetMicros String
  selfServiceGrantCount Int
  automaticGrantCount Int
  version Int
  updatedAt DateTime
}

type GetMyBudgetBalanceInput {
  period String
}

// Reads the caller's own current budget balance for `period`. An account that has never had a
// grant this period gets a zero-valued `BudgetBalance` back, not an error -- see
// `BalanceSnapshot::zero`'s own doc comment for why "no row yet" and "zero budget" are the same
// answer from a caller's point of view even though the repository layer distinguishes them.
// Gated at `budget:read-own` (`Permission::BudgetReadOwn`).
procedure getMyBudgetBalance(args: GetMyBudgetBalanceInput): BudgetBalance
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetReadOwn == true)

type GetBudgetBalanceInput {
  budgetAccountId String
  period String
}

// The admin equivalent of `getMyBudgetBalance`: reads any account's balance, not only the
// caller's own. Gated at `budget:read` (`Permission::BudgetRead`) -- the highest-value permission
// this PR wires up, since `budget_balances` was previously unreadable by anyone, admin included.
procedure getBudgetBalance(args: GetBudgetBalanceInput): BudgetBalance
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetRead == true)

// One page of the `budget_grants` append-only ledger (ADR-0009). `nextCursor` is the `createdAt`
// of the last entry on this page -- pass it back as `before` on the next call to page further
// back in time; `null` means there is no further page. Ordered strictly newest-first by
// `createdAt` -- per ADR-0039, ids are opaque CUID2 strings with no defined ordering, so
// pagination is by `createdAt` only, never by id (see `BudgetRepo::list_grants`'s own doc
// comment). `matchedRuleIds` is a required `String[]`, not `String[]?`, for the same
// TypeArity-grammar reason `AugmentationRequest.matchedRuleIds` already documents above --
// `budget_grants.matched_rule_ids` is `NULL` for any grant a policy engine didn't attach rule ids
// to (i.e. every grant that isn't an auto-approved self-service refill), mapped to an empty list
// here rather than losing the ability to express "no matched rules" as a nullable array.
type BudgetGrantEntry {
  id String
  budgetAccountId String
  accountId String
  projectId String?
  period String
  amountMicros String
  source String
  actorId String?
  reason String?
  policyRevision String?
  matchedRuleIds String[]
  idempotencyKey String?
  triggerKey String?
  createdAt DateTime
  expiresAt DateTime?
  revokedAt DateTime?
}

type BudgetGrantPage {
  entries BudgetGrantEntry[]
  nextCursor DateTime?
}

type ListMyBudgetGrantsInput {
  period String?
  before DateTime?
  limit Int?
}

// The caller's own ledger history -- `budget:audit-read`'s self-scoped counterpart, folded into
// `budget:read-own` (see that permission's doc comment: reading your own balance and reading your
// own history are one "see your own budget" capability here, the same way `budget:review` bundles
// listing the review queue with acting on it, rather than a fifth permission for one narrower
// slice). `period: null` lists across every period for this account; `limit` is clamped server-side
// (`BudgetRepo::list_grants`) regardless of what is requested.
procedure listMyBudgetGrants(args: ListMyBudgetGrantsInput): BudgetGrantPage
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetReadOwn == true)

type ListBudgetGrantsInput {
  budgetAccountId String
  period String?
  before DateTime?
  limit Int?
}

// The admin equivalent of `listMyBudgetGrants`: the audit trail for any account. Gated at
// `budget:audit-read` (`Permission::BudgetAuditRead`) -- this is what makes the append-only ledger
// actually readable by anyone, not just written.
procedure listBudgetGrants(args: ListBudgetGrantsInput): BudgetGrantPage
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetAuditRead == true)

// A direct admin grant, bypassing self-service policy evaluation entirely (`budget:grant`,
// `Permission::BudgetGrant`) -- e.g. a support-driven top-up. Delegates to the exact same
// `BudgetRepo::grant` transactional write path every other grant source already uses (ledger
// insert + balance-projection update, atomically, under the same per-(account,period) row lock),
// with `source = "admin"`. `idempotencyKey`, when supplied, makes a genuine client retry return
// the SAME grant rather than granting twice -- the same idempotency contract
// `requestBudgetRefill` already documents. The ledger is append-only (ADR-0009): this inserts a
// new row, never mutates one.
type GrantBudgetInput {
  budgetAccountId String
  accountId String
  projectId String?
  period String
  amountMicros String
  reason String?
  idempotencyKey String?
}

mutation procedure grantBudget(args: GrantBudgetInput): BudgetGrantEntry
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetGrant == true)

// The compensating-correction counterpart to `grantBudget` (`budget:revoke`,
// `Permission::BudgetRevoke`). Per ADR-0009, an already-committed `budget_grants` row can never be
// updated or deleted (the DB trigger `budget_grants_forbid_mutation` rejects it outright) -- this
// procedure never attempts to; it looks up `grantId`, and writes a NEW `source = "correction"` row
// for the SAME `(budgetAccountId, accountId, projectId, period)` carrying the negated
// `amountMicros`, which nets the original grant's effect out of `effective_budget_micros` (per
// `budget_balances`' bucket-mapping doc comment: a correction adjusts `effective_budget_micros`
// only, never the original source's bucket) while leaving the original row completely unchanged
// and still visible in `listBudgetGrants`/`listMyBudgetGrants`. The correction's idempotency key is
// derived from `grantId` server-side (`"revoke:{grantId}"`), so calling this twice for the same
// `grantId` returns the SAME correction rather than negating twice.
type RevokeBudgetGrantInput {
  grantId String
  reason String
}

mutation procedure revokeBudgetGrant(args: RevokeBudgetGrantInput): BudgetGrantEntry
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetRevoke == true)

// Authors a new budget-policy revision WITHOUT activating it (`budget:policy-write`,
// `Permission::BudgetPolicyWrite`) -- deliberately kept separate from `activateBudgetPolicy`
// (`budget:policy-activate`) per ADR-0007: with arbitrary rule data, writing a policy is shipping
// executable logic into the decision path, so the identity authoring it should not be the same one
// that puts it live. Delegates to `PolicyStore::create_revision`, which validates
// `ruleDataJson` with the exact same `validate_rule_data` `activateBudgetPolicy` uses BEFORE
// writing anything -- a revision that fails validation is never persisted at all, preserving "a
// bad revision never displaces a good one" for the write path too. The currently active revision
// is completely untouched by this call; a separate `activateBudgetPolicy { revisionId }` call
// (the existing rollback/promote path) is what would later make this new revision serve.
type CreateBudgetPolicyRevisionInput {
  policySetId String
  ruleDataJson String
}

type BudgetPolicyRevisionRef {
  policySetId String
  revisionId String
  policyRevision String
}

mutation procedure createBudgetPolicyRevision(args: CreateBudgetPolicyRevisionInput): BudgetPolicyRevisionRef
  @allow((auth() != null) && auth().rpcScope == "budget" && auth().permBudgetPolicyWrite == true)
